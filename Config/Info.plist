<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Everything else in this file is generated (GENERATE_INFOPLIST_FILE), and this
	  partial is merged into it. It exists for one key: there is no
	  INFOPLIST_KEY_UIBackgroundModes build setting — Xcode accepts the name and silently
	  drops it — so the only way to declare a background mode is a file (D-036).

	  remote-notification is here because iCloud sync needs it: CKSyncEngine is told about
	  another device's changes by a silent push, and without this the app is not woken to
	  read it. No notification is ever shown.
	-->
	<!--
	  The backup file type (D-040). Declared so Files.app names it, shows the app's icon
	  beside it, and offers Apex Terminal when one is opened from elsewhere — a backup
	  nobody can find again is not a backup.
	-->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.apexterminal.backup</string>
			<key>UTTypeDescription</key>
			<string>Apex Terminal Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apexbackup</string>
				</array>
			</dict>
		</dict>
	</array>
	<!--
	  The two link schemes this app answers (D-061). `ssh` is the one people already have
	  in notes, wikis and READMEs; `apexterminal` is this app's own, for what a generic SSH
	  URL cannot say — which saved connection, and what to run on it.

	  Declaring a scheme means anything on the device, and any web page, can send this app
	  a link. Nothing arriving this way runs without being shown first: see
	  `IncomingURL.authorisation`.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>dev.apexterminal.ssh</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ssh</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>dev.apexterminal.link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>apexterminal</string>
			</array>
		</dict>
	</array>
	<!--
	  The activity a session publishes so another device can pick up the same connection
	  (D-061). It carries which saved connection it is and nothing else — an SSH session
	  cannot be moved, so continuing elsewhere opens a new one to the same server.
	-->
	<key>NSUserActivityTypes</key>
	<array>
		<string>dev.apexterminal.session</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
