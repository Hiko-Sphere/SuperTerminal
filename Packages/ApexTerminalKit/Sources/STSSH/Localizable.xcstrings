          "stringUnit": {
            "state": "translated",
            "value": "伺服器可能只提供 RSA host key。請參閱說明文件中的演算法相容性說明。"
          }
        }
      }
    },
    "The server may require an algorithm this app does not support. See the compatibility notes in the documentation.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
