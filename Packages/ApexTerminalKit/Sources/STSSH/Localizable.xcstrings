          "stringUnit": {
            "state": "translated",
            "value": "伺服器在 SSH 工作階段建立前關閉了連線。"
          }
        }
      }
    },
    "The server may only offer RSA host keys. See the algorithm compatibility notes in the documentation.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器可能只提供 RSA host key。请参阅文档中的算法兼容性说明。"
