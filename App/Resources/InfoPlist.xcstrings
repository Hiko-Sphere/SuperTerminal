    "NSFaceIDUsageDescription": {
      "comment": "Shown in the system Face ID sheet when unlocking a biometric-protected SSH key.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启「App 锁」后，Apex Terminal 会用 Face ID 解锁应用；使用你选择用 Face ID 保护的 SSH 密钥前，也会先请求验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「App 鎖定」後，Apex Terminal 會以 Face ID 解鎖應用程式；使用你選擇以 Face ID 保護的 SSH 金鑰前，也會先請求驗證。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apex Terminal asks for Face ID to unlock the app when App Lock is on, and before it uses an SSH key you chose to protect with Face ID."
          }
        }
      }
    }
  },
  "version": "1.0"
