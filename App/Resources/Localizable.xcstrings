    "Terminal text can contain secrets. Look before you send.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端文本可能包含机密。发送前请先查看。"
          }
