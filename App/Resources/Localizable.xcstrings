    },
    "SuperTerminal is available in English, Simplified Chinese and Traditional Chinese. Terminal output is never translated — it comes from the remote machine exactly as it was sent.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SuperTerminal 提供英文、简体中文和繁体中文。终端输出永远不会被翻译——它原样来自远程主机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SuperTerminal 提供英文、簡體中文和繁體中文。終端機輸出永遠不會被翻譯——它原樣來自遠端主機。"
          }
        }
      }
    },
    "SuperTerminal signs in to Cloudflare Access in a system browser, then opens the tunnel itself. No cloudflared install is needed on this device.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SuperTerminal 会在系统浏览器中登录 Cloudflare Access，然后自行打开 Tunnel。本设备无需安装 cloudflared。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SuperTerminal 會在系統瀏覽器中登入 Cloudflare Access，然後自行開啟 Tunnel。本裝置無需安裝 cloudflared。"
          }
        }
      }
    },
    "SuperTerminal, %@": {
