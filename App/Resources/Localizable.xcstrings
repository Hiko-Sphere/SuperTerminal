    "Apex Terminal is available in English, Simplified Chinese and Traditional Chinese. Terminal output is never translated — it comes from the remote machine exactly as it was sent.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apex Terminal 提供英文、简体中文和繁体中文。终端输出永远不会被翻译——它原样来自远程主机。"
          }
        },
        "zh-Hant": {
