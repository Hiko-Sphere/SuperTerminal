          "stringUnit": {
            "state": "translated",
            "value": "螢幕共享連線意外中斷。"
          }
        }
      }
    },
    "The screen sharing port must be between 1 and 65535.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕共享端口必须在 1 到 65535 之间。"
