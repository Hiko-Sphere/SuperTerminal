          }
        }
      }
    },
    "This build cannot reach iCloud: it is signed without the app's iCloud container. Install a build signed with the right team.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建无法访问 iCloud：签名中不含本应用的 iCloud 容器。请安装使用正确开发团队签名的构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此建置無法存取 iCloud：簽章中不含本 App 的 iCloud 容器。請安裝使用正確開發團隊簽章的建置。"
          }
        }
      }
    },
    "This build cannot reach its shared storage, so servers cannot appear in Files.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本无法访问共享存储，因此服务器无法出现在「文件」中。"
          }
        },
        "zh-Hant": {
