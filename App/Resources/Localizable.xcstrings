            "value": "此操作無法復原。"
          }
        }
      }
    },
    "This certificate is outside its validity window, so it is not offered. The key itself is still offered on its own.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
