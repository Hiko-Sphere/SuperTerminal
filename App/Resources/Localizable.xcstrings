    "Add this line to ~/.ssh/authorized_keys on the server. The private half stays on this device and is never shown or shared.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这一行添加到服务器上的 ~/.ssh/authorized_keys。私钥部分保留在本设备上，绝不会被显示或共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將這一行加入伺服器上的 ~/.ssh/authorized_keys。私密金鑰部分保留在本裝置上，絕不會被顯示或分享。"
          }
        }
      }
    },
    "Add this line to ~/.ssh/authorized_keys on the server. The private half was created inside the Secure Enclave, has never existed outside it, and cannot be exported, backed up or moved to another device.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这一行加入服务器的 ~/.ssh/authorized_keys。私钥是在 Secure Enclave 内部生成的，从未在其之外存在过，无法导出、备份，也无法移动到其他设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這一行加入伺服器的 ~/.ssh/authorized_keys。私密金鑰是在 Secure Enclave 內部產生的，從未在其之外存在過，無法匯出、備份，也無法移動到其他裝置。"
          }
        }
      }
