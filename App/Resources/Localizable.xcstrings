      }
    },
    "The two entries do not match.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两次输入不一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩次輸入不一致。"
          }
        }
      }
    },
    "There is no account, no server, no analytics and no crash reporter. Traffic goes only to the servers you connect to and, for tunnelled hosts, to Cloudflare on your behalf.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有账户、没有服务器、没有分析，也没有崩溃报告器。流量只会发往您所连接的服务器，以及（对于经隧道连接的主机）代表您发往 Cloudflare。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有帳號、沒有伺服器、沒有分析，也沒有當機回報器。流量只會傳送至您所連線的伺服器，以及（對於經隧道連線的主機）代表您傳送至 Cloudflare。"
          }
        }
      }
    },
    "These questions come from the server, in its own words. Nothing typed here is saved.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些问题来自服务器，措辞原样呈现。此处输入的内容不会被保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些問題來自伺服器，措辭原樣呈現。此處輸入的內容不會被儲存。"
          }
        }
      }
    },
