    "Add a server to get started. Apex Terminal supports plain SSH and servers published through Cloudflare Tunnel, and remote screens over VNC.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一台服务器即可开始。Apex Terminal 支持普通 SSH、通过 Cloudflare Tunnel 发布的服务器，以及基于 VNC 的远程屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入一台伺服器即可開始。Apex Terminal 支援一般 SSH、透過 Cloudflare Tunnel 發布的伺服器，以及基於 VNC 的遠端螢幕。"
          }
        }
      }
    },
