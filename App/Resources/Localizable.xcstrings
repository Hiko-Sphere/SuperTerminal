    },
    "The document %@ is not included in this build.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未包含文档 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未包含文件 %@。"
          }
        }
      }
    },
    "The file is encrypted with the password you type here. It is not stored anywhere, and without it the backup cannot be opened — not by anyone, including you.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会用你在这里输入的密码加密。该密码不会保存在任何地方，没有它就打不开这份备份——任何人都不行，包括你自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會用你在這裡輸入的密碼加密。該密碼不會儲存在任何地方，沒有它就打不開這份備份——任何人都不行，包括你自己。"
          }
        }
      }
    },
    "The files on this server could not be opened.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开此服务器上的文件。"
          }
        },
        "zh-Hant": {
