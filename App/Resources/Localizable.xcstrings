{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ (CloudKit %lld)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（CloudKit %lld）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（CloudKit %lld）"
          }
        }
      }
    },
    "%@ Screen": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 屏幕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 螢幕"
          }
        }
      }
    },
    "%@ at %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上的 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上的 %1$@"
          }
        }
      }
    },
    "%@ is presenting a different key from the one recorded. This happens when a server is rebuilt or rekeyed — and it is also what an interception attack looks like.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 出示的密钥与已记录的密钥不同。服务器被重建或更换密钥时会这样，而拦截攻击看起来也正是这样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 出示的金鑰與已記錄的金鑰不同。伺服器被重建或更換金鑰時會這樣，而攔截攻擊看起來也正是這樣。"
          }
        }
      }
    },
    "%@ is showing in a different window. The connection is still running.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在另一个窗口中显示。连接仍处于活动状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在另一個視窗中顯示。連線仍在使用中。"
          }
        }
      }
    },
    "%@ through %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，经由 %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，經由 %2$@"
          }
        }
      }
    },
    "%@ through Cloudflare": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，经由 Cloudflare"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，經由 Cloudflare"
