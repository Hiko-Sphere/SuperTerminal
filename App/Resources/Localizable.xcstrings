    },
    "%@. Will retry as soon as there is one.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。有网络后将立即重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。有網路後將立即重試。"
          }
        }
      }
    },
    "%@@%@:%@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
