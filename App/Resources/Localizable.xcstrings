    "Tap to click. Touch and hold to drag. Two fingers scroll or, when zoomed, pan.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点即点击。按住后拖动即拖拽。双指滚动；放大后双指平移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
