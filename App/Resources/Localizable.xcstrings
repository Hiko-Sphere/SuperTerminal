    "Connected in the order listed, then on to this server. The last hop carries the traffic without being able to read it: the session is encrypted between this device and the destination.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按列出的顺序依次连接，最后到达此服务器。最后一跳只负责承载流量，读不到内容：会话在本设备与目标之间端到端加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按列出的順序依次連線，最後到達此伺服器。最後一跳只負責承載流量，讀不到內容：工作階段在本裝置與目標之間端到端加密。"
          }
        }
      }
    },
