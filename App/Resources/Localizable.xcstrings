            "state": "translated",
            "value": "裝置端模型仍在下載。"
          }
        }
      }
    },
    "The on-device model is turned off in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端模型已在「设置」中关闭。"
