      }
    },
    "This screen's user name and password can each be at most 63 characters.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此屏幕的用户名和密码各自最多 63 个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此螢幕的使用者名稱和密碼各自最多 63 個字元。"
          }
        }
      }
    },
    "This server appears in the Files app, where you can browse it, open files and save them back. Apex Terminal connects when Files asks and disconnects shortly after, so a change made on the server appears when you open or refresh the folder.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器会出现在「文件」App 中，你可以在那里浏览、打开文件并保存回服务器。Apex Terminal 会在「文件」需要时连接，并在稍后断开，因此服务器上的改动会在你打开或刷新文件夹时才显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器會出現在「檔案」App 中，你可以在那裡瀏覽、開啟檔案並儲存回伺服器。Apex Terminal 會在「檔案」需要時連線，並在稍後斷開，因此伺服器上的變更會在你開啟或重新整理檔案夾時才顯示。"
          }
        }
      }
    },
    "This server has not been seen before. Check that the fingerprint below matches the server.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前从未见过该服务器。请核对下方的 fingerprint 与服务器上的是否一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先前從未見過此伺服器。請核對下方的 fingerprint 與伺服器上的是否一致。"
          }
        }
      }
    },
