          }
        }
      }
    },
    "This connection has no user name saved. Edit the connection to save one.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接没有保存用户名。编辑连接即可保存一个。"
          }
        },
