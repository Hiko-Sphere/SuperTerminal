    "Add a server to get started. SuperTerminal supports plain SSH and servers published through Cloudflare Tunnel.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一台服务器即可开始。SuperTerminal 支持普通 SSH，也支持通过 Cloudflare Tunnel 发布的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增一台伺服器即可開始。SuperTerminal 支援一般 SSH，也支援透過 Cloudflare Tunnel 發布的伺服器。"
          }
        }
