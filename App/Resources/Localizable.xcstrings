    "Tapping this snippet runs it straight away. Leave it off for anything you would want to check first.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点此命令片段会立即运行。对于任何你想先核对的内容，请保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點此指令片段會立即執行。對於任何你想先核對的內容，請保持關閉。"
          }
        }
      }
    },
    "Terminal": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端"
          }
        },
        "zh-Hant": {
