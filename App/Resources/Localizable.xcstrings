        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接可能来自任何地方——网页、消息、墙上的二维码。在您允许之前，不会向服务器发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結可能來自任何地方——網頁、訊息、牆上的二維條碼。在您允許之前，不會向伺服器送出任何內容。"
          }
        }
      }
