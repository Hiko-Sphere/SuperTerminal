            "value": "%lld 筆新增"
          }
        }
      }
    },
    "%lld new, %lld already here": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条新增，%lld 条已存在"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 筆新增，%lld 筆已存在"
          }
        }
      }
    },
    "%lld of %lld": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 项，共 %lld 项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 項，共 %lld 項"
          }
        }
      }
    },
    "%lld open · %@ sent · %@ received": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个连接 · 已发送 %@ · 已接收 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個連線 · 已傳送 %@ · 已接收 %@"
          }
        }
      }
    },
    "%lld record(s) already exist here.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 条记录在本设备上已存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 筆記錄在本裝置上已存在。"
          }
        }
      }
    },
    "%lld×": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld×"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld×"
          }
        }
      }
    },
    "1 minute": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分鐘"
          }
        }
      }
    },
    "30 seconds": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 秒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "30 秒"
          }
        }
      }
    },
    "5 minutes": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分鐘"
          }
        }
      }
    },
    "644": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "644"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "644"
          }
        }
      }
    },
    "A backup can always be read by the version that wrote it or a later one, never an earlier one.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份总能被写出它的版本或更新的版本读取，但更旧的版本不行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份總能被寫出它的版本或更新的版本讀取，但更舊的版本不行。"
          }
        }
      }
    },
    "A deleted connection": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个已删除的连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個已刪除的連線"
          }
        }
      }
    },
    "A direct SSH connection to the host and port above.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与上方主机和端口建立的直接 SSH 连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與上方主機和連接埠建立的直接 SSH 連線。"
          }
        }
      }
    },
    "A direct connection to the VNC port. VNC itself is unencrypted and its password check is weak: use this only on a network you trust.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接连接到 VNC 端口。VNC 本身不加密，其密码验证也很弱：请只在您信任的网络上使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接連線到 VNC 連接埠。VNC 本身不加密，其密碼驗證也很弱：請只在您信任的網路上使用。"
          }
        }
      }
    },
    "A folder must be empty before it can be deleted, and a name must not already be taken.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹必须为空才能删除，且名称不能已被占用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料夾必須為空才能刪除，且名稱不能已被占用。"
          }
        }
      }
    },
    "A folder must be empty before it can be deleted.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹必须为空才能删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料夾必須為空才能刪除。"
          }
        }
      }
    },
    "A forward carries a port on this device to a port the server can reach, or the other way round.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转发把本设备上的一个端口接到服务器能访问的端口，或者反过来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉發把本裝置上的一個連接埠接到伺服器能存取的連接埠，或者反過來。"
          }
        }
      }
    },
    "A forward runs only while Apex Terminal is running and this connection is open. Leaving the app for long enough suspends it, and the forward stops with it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转发只在 Apex Terminal 运行、且此连接保持打开时有效。离开 App 足够久，系统会挂起它，转发也随之停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉發只在 Apex Terminal 執行、且此連線保持開啟時有效。離開 App 夠久，系統會暫停它，轉發也隨之停止。"
          }
        }
      }
    },
    "A key protected by Face ID or Touch ID cannot be stored in iCloud Keychain. Turn one of the two off.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受 Face ID 或 Touch ID 保护的密钥无法存放在 iCloud Keychain 中。请关闭其中一项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受 Face ID 或 Touch ID 保護的金鑰無法存放在 iCloud Keychain 中。請關閉其中一項。"
          }
        }
      }
    },
    "A key protected by Face ID or Touch ID stays on this device; iCloud Keychain cannot hold it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受 Face ID 或 Touch ID 保护的密钥只保留在本设备上；iCloud Keychain 无法存放它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受 Face ID 或 Touch ID 保護的金鑰只保留在本裝置上；iCloud Keychain 無法存放它。"
          }
        }
      }
    },
    "A key that changes is refused": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥变更会被拒绝"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰變更會被拒絕"
          }
        }
      }
    },
    "A link wants to connect to a server you have not saved": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有链接想连接到您尚未保存的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有連結想連線至您尚未儲存的伺服器"
          }
        }
      }
    },
    "A link wants to run a command": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有链接想运行一条命令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有連結想執行一道指令"
          }
        }
      }
    },
    "A passcode cannot contain a line break.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码不能包含换行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼不能包含換行。"
          }
        }
      }
    },
    "A pasted address is taken apart: ssh.example.com:443, ssh://deploy@host:2222 and [2001:db8::1]:22 all work. A blank user name is asked for each time the connection opens.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴的地址会被自动拆分：ssh.example.com:443、ssh://deploy@host:2222 和 [2001:db8::1]:22 都可以。用户名留空时，每次打开连接都会询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上的位址會被自動拆分：ssh.example.com:443、ssh://deploy@host:2222 和 [2001:db8::1]:22 都可以。使用者名稱留空時，每次開啟連線都會詢問。"
          }
        }
      }
    },
    "A program on this server tried to copy to your clipboard. Settings → Security can allow it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器上的某个程序尝试复制到您的剪贴板。可在“设置 → 安全”中允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器上的某個程式嘗試複製到您的剪貼簿。可在「設定 → 安全性」中允許。"
          }
        }
      }
    },
    "A remote screen shows the whole desktop over VNC. Tap to click, hold to drag, two fingers to scroll, or use a keyboard and mouse. It can travel inside an SSH connection, so nothing need be exposed.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程屏幕通过 VNC 显示整个桌面。点按即点击，长按可拖动，双指滚动，也可以使用键盘和鼠标。它可以走在 SSH 连接内部，因此无需对外暴露任何端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端螢幕透過 VNC 顯示整個桌面。點一下即點按，長按可拖曳，兩指捲動，也可以使用鍵盤和滑鼠。它可以走在 SSH 連線內部，因此無需對外開放任何連接埠。"
          }
        }
      }
    },
    "A server whose host key carries a certificate from an authority you trust is accepted without you comparing a fingerprint.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果服务器的主机密钥带有你信任的颁发机构签发的证书，就无需你比对指纹即可接受。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果伺服器的主機金鑰帶有你信任的憑發機構簽發的憑證，就無需你比對指紋即可接受。"
          }
        }
      }
    },
    "A service token signs in without a browser. Create one in Cloudflare Zero Trust → Access → Service Auth and allow it in the application's policy. It is kept in this device's Keychain, never synced, and deleted with the connection.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务令牌无需浏览器即可登录。请在 Cloudflare Zero Trust → Access → Service Auth 中创建一个，并在该应用程序的策略中允许它。它保存在本设备的 Keychain 中，从不同步，并随连接一起删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務權杖無需瀏覽器即可登入。請在 Cloudflare Zero Trust → Access → Service Auth 中建立一個，並在該應用程式的政策中允許它。它保存在本裝置的 Keychain 中，絕不同步，並隨連線一併刪除。"
          }
        }
      }
    },
    "A user name is only needed for a screen that signs in to an account — a Mac sharing its screen, or a server using VeNCrypt. Leave it empty otherwise. The password is kept in this device's Keychain, never synced and never in the screen's record; leave it empty to be asked when the screen opens.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有需要登录账户的屏幕才需要用户名——例如开启了屏幕共享的 Mac，或使用 VeNCrypt 的服务器。其他情况留空即可。密码保存在本设备的钥匙串中，不会同步，也不会写入屏幕的记录；留空则在打开屏幕时询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有需要登入帳號的螢幕才需要使用者名稱——例如開啟了螢幕共享的 Mac，或使用 VeNCrypt 的伺服器。其他情況留空即可。密碼儲存在本裝置的鑰匙圈中，不會同步，也不會寫入螢幕的記錄；留空則在開啟螢幕時詢問。"
          }
        }
      }
    },
