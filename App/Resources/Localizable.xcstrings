          "stringUnit": {
            "state": "translated",
            "value": "无法读取服务提供方的回复：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取服務提供者的回覆：%@"
          }
        }
      }
    },
    "The remote copied text": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程电脑复制了文本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端電腦拷貝了文字"
          }
        }
      }
    },
    "The remote program supports bracketed paste, so the text will be inserted without running it. Check it before pressing Return.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远端程序支持 bracketed paste，因此文本只会被插入，不会直接运行。按 Return 键前请先核对内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端程式支援 bracketed paste，因此文字只會被插入，不會直接執行。按 Return 鍵前請先核對內容。"
          }
        }
      }
    },
    "The row above the keyboard has Control, Escape, Tab and the arrows. Tap Control and it latches for the next key, so Control then C sends ^C. An external keyboard works too.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘上方那一行有 Control、Escape、Tab 和方向键。点一下 Control 会为下一个按键保持按住状态，所以先按 Control 再按 C 就是 ^C。外接键盘同样可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤上方那一列有 Control、Escape、Tab 和方向鍵。點一下 Control 會為下一個按鍵保持按住狀態，所以先按 Control 再按 C 就是 ^C。外接鍵盤同樣可用。"
          }
        }
      }
    },
    "The screen could not be opened.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟螢幕。"
          }
        }
      }
    },
    "The screen sharing connection ended unexpectedly.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕共享连接意外中断。"
          }
        },
