{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Connect to ${connection} in ${applicationName}": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用${applicationName}连接到${connection}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用${applicationName}連線到${connection}"
          }
        }
      }
    },
    "Open ${connection} in ${applicationName}": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在${applicationName}中打开${connection}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在${applicationName}中打開${connection}"
          }
        }
      }
    },
    "SSH to ${connection} with ${applicationName}": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用${applicationName} SSH 到${connection}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用${applicationName} SSH 到${connection}"
          }
        }
      }
    },
    "Disconnect all sessions in ${applicationName}": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开${applicationName}的所有会话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷${applicationName}的所有工作階段"
          }
        }
      }
    }
  }
}