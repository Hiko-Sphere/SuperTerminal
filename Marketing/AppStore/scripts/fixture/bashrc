# The shell the screenshots show.
#
# Read twice on purpose: as /etc/profile.d/superterminal.sh by the login shell OpenSSH
# starts, and as ~/.bashrc by anything that starts a non-login interactive shell. The
# colours in the prompt are real SGR sequences — rendering them is the app's job, and
# showing that it does is part of the point.
export TERM=${TERM:-xterm-256color}
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export PAGER=less
export EDITOR=vim
export PS1='\[\e[1;38;5;42m\]\u@\h\[\e[0m\]:\[\e[1;38;5;75m\]\w\[\e[0m\]$ '
alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
alias la='ls -A --color=auto'
alias grep='grep --color=auto'
