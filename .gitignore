# macOS
.DS_Store
.build/emulator.trace
__pycache__/

# The App Store capture run's scratch: xcresult bundles, logs, and the throwaway SSH key
# it authorises inside the fixture containers. The key is regenerated on every run and
# must never be committed.
Marketing/AppStore/build/

# The 2026-09 rebuild's capture scratch: xcresult bundles and the throwaway SSH key each
# run generates. That key authorises nothing but the run's own containers, and must still
# never be committed.
Marketing/Rebuild-2026-09-10/automation/build/

# Generated site
Website/dist/

# Apple credentials — never commit these
*.p8
AuthKey_*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
